<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Calcul Multi m²</title>

<style>
body{
  background:#000;
  color:#fff;
  font-family:Arial;
  padding:20px;
}

h1{
  text-align:center;
  font-size:26px;
}

.line{
  background:#111;
  padding:12px;
  border-radius:10px;
  margin-bottom:12px;
}

input{
  width:100%;
  padding:10px;
  margin:6px 0;
  font-size:18px;
  border-radius:8px;
  border:none;
  outline:none;
}

.result{
  text-align:center;
  font-size:20px;
  margin-top:6px;
  opacity:0.8;
}

button{
  width:100%;
  padding:12px;
  background:#00ff99;
  color:#000;
  border:none;
  border-radius:8px;
  font-size:20px;
  margin-top:10px;
  font-weight:bold;
}

.delete{
  background:#ff4444;
  color:#fff;
  margin-top:8px;
}

#totalT{
  font-size:32px;
  text-align:center;
  margin-top:20px;
  font-weight:bold;
}

#totalKG{
  text-align:center;
  font-size:20px;
  opacity:0.7;
}
</style>
</head>

<body>

<h1>Calcul Multi m²</h1>

<div id="container"></div>

<button onclick="addLine()">+ Ajouter une ligne</button>

<div id="totalT">0.000 T</div>
<div id="totalKG">0 kg</div>

<a href="index.html" style="color:#00ff99;display:block;text-align:center;margin-top:20px;font-size:18px;">⬅ Retour</a>

<script>
function addLine(){
  const div = document.createElement("div");
  div.className = "line";

  div.innerHTML = `
    <input type="text" inputmode="decimal" placeholder="m²" class="m2">
    <input type="text" inputmode="decimal" placeholder="Épaisseur (cm)" class="ep">
    <div class="result">0.000 T</div>
    <button class="delete" onclick="this.parentNode.remove(); calcTotal();">🗑 Supprimer</button>
  `;

  document.getElementById("container").appendChild(div);

  div.querySelectorAll("input").forEach(el=>{
    el.addEventListener("input", calcTotal);
  });

  calcTotal();
}

function calcTotal(){
  let totalT = 0;

  document.querySelectorAll(".line").forEach(line=>{
    const m2 = parseFloat(line.querySelector(".m2").value.replace(",", ".")) || 0;
    const ep = parseFloat(line.querySelector(".ep").value.replace(",", ".")) || 0;

    const volume = m2 * (ep / 100);
    const tonnes = volume * 2.7;

    line.querySelector(".result").textContent = tonnes.toFixed(3) + " T";

    totalT += tonnes;
  });

  document.getElementById("totalT").textContent = totalT.toFixed(3) + " T";
  document.getElementById("totalKG").textContent = Math.round(totalT * 1000).toLocaleString() + " kg";
}

window.addEventListener("load", ()=>{
  addLine();
});
</script>

</body>
</html>
